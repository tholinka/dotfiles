# if running bash (from ubuntu's .profile)
if [ -n "$BASH_VERSION" ]; then
	# include .bashrc if it exists
	if [ -f "$HOME/.bashrc" ]; then
		. "$HOME/.bashrc"
	fi
fi

pathprepend() {
	for ARG in "$@"; do
		if [[ ":$PATH:" != *":$ARG:"* ]]; then
			PATH="$ARG${PATH:+":$PATH"}"
		fi
	done
}
pathappend() {
	for ARG in "$@"; do
		if [[ ":$PATH:" != *":$ARG:"* ]]; then
			PATH="${PATH:+"$PATH:"}$ARG"
		fi
	done
}

# add global executable folders to PATH
pathappend /usr/local/bin /usr/bin /bin /usr/sbin /sbin

# add local-user executable folders to PATH
pathprepend "$HOME/.local/bin"

# add rust-lang's cargo executables to PATH
pathappend "$HOME/.cargo/bin"

# add Golang
export GOPATH="$HOME/.go"
export GOBIN="$HOME/.go/bin"
pathappend "$GOBIN"

# add rbenv
pathappend "$HOME/.rbenv/bin"

# add snap - only if needed, just to minimize PATH clutter
[[ -d /snap/bin ]] && pathappend /snap/bin

# add colorgcc
pathprepend /usr/lib/colorgcc/bin

{{ if eq .chezmoi.os "darwin" -}}
# include brew and coreutils
eval "$(/opt/homebrew/bin/brew shellenv)"
# add gnu coreutils and brew bin to PATH
PATH="$HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin:$PATH"
export _MAC=true

{{ end -}}

export PATH

# add local stuff to library path, might already be added
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH${LD_LIBRARY_PATH+:}$HOME/usr/lib:$HOME/lib:$HOME/.local/lib"

# add ccache
export CCACHE_PATH="/usr/bin"
